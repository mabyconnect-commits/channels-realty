{
  "name": "channels-realty",
  "version": "0.2.0",
  "private": true,
  "description": "Channels Realty — co-own property. Frontend (Phase 1) + Vercel serverless backend (Phase 2).",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "check:jsx": "node scripts/check-jsx.js",
    "check:api": "node scripts/check-api.js",
    "dev": "npx --yes serve -l 3000 .",
    "start": "npx --yes serve -l 3000 .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
